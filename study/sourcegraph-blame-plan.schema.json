{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcegraph cutoff-pinned blame plan v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blame_plan_version",
    "status",
    "packet_index_sha256",
    "group_count",
    "query_group_count",
    "pending_file_enrichment_count",
    "path_only_enrichment_count",
    "line_number_basis",
    "precise_code_intelligence_used",
    "scip_used",
    "outcomes_consulted",
    "groups",
    "blame_plan_sha256"
  ],
  "properties": {
    "blame_plan_version": {"const": 3},
    "status": {"const": "frozen_before_blame_execution"},
    "packet_index_sha256": {"$ref": "#/$defs/sha256"},
    "group_count": {"type": "integer", "minimum": 0},
    "query_group_count": {"type": "integer", "minimum": 0},
    "pending_file_enrichment_count": {"type": "integer", "minimum": 0},
    "path_only_enrichment_count": {"type": "integer", "minimum": 0},
    "line_number_basis": {
      "const": "zero_based_search_one_based_blame_api"
    },
    "precise_code_intelligence_used": {"const": false},
    "scip_used": {"const": false},
    "outcomes_consulted": {"const": false},
    "groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/group"}
    },
    "blame_plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resultId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_manifest_sha256",
        "sourcegraph_result_id",
        "canonical_repository_id",
        "sourcegraph_name",
        "cutoff_commit",
        "path",
        "sourcegraph_line_numbers"
      ],
      "properties": {
        "result_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sourcegraph_result_id": {"$ref": "#/$defs/resultId"},
        "canonical_repository_id": {"type": "string", "minLength": 3},
        "sourcegraph_name": {"type": "string", "minLength": 1},
        "cutoff_commit": {"$ref": "#/$defs/sha1"},
        "path": {"type": "string", "minLength": 1},
        "sourcegraph_line_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_repository_id",
        "sourcegraph_name",
        "cutoff_commit",
        "path",
        "requested_lines",
        "blame_api_lines",
        "pending_enrichments",
        "group_id"
      ],
      "properties": {
        "canonical_repository_id": {"type": "string", "minLength": 3},
        "sourcegraph_name": {"type": "string", "minLength": 1},
        "cutoff_commit": {"$ref": "#/$defs/sha1"},
        "path": {"type": "string", "minLength": 1},
        "requested_lines": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "blame_api_lines": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "pending_enrichments": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pending"}
        },
        "group_id": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
