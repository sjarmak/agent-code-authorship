{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-adoption-audit-response.schema.json",
  "title": "Independent Sourcegraph adoption reliability-audit response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_version",
    "worksheet_sha256",
    "audit_task_id",
    "task_id",
    "task_sha256",
    "canonical_repository_id",
    "event_id",
    "reviewer_id",
    "decision",
    "default_branch_supported",
    "evidence_tier",
    "rationale",
    "evidence_citations",
    "outcomes_consulted",
    "response_sha256"
  ],
  "properties": {
    "response_version": {
      "const": 1
    },
    "worksheet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "audit_task_id": {
      "$ref": "#/$defs/sha256"
    },
    "task_id": {
      "$ref": "#/$defs/sha256"
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_repository_id": {
      "type": "string",
      "minLength": 3
    },
    "event_id": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accept_confirmed",
        "accept_observed",
        "insufficient",
        "reject",
        "unresolved"
      ]
    },
    "default_branch_supported": {
      "type": "boolean"
    },
    "evidence_tier": {
      "enum": [
        "confirmed",
        "observed",
        "not_applicable"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_citations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "response_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accept_confirmed"
          }
        }
      },
      "then": {
        "properties": {
          "default_branch_supported": {
            "const": true
          },
          "evidence_tier": {
            "const": "confirmed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accept_observed"
          }
        }
      },
      "then": {
        "properties": {
          "default_branch_supported": {
            "const": true
          },
          "evidence_tier": {
            "const": "observed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "insufficient",
              "reject",
              "unresolved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "default_branch_supported": {
            "const": false
          },
          "evidence_tier": {
            "const": "not_applicable"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
