{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sg-evals.local/schemas/sg-evals-github-audit.v3.json",
  "title": "Read-only sg-evals GitHub state audit v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_version",
    "kind",
    "observed_at",
    "outcomes_consulted",
    "repository_count",
    "repositories",
    "audit_sha256"
  ],
  "properties": {
    "audit_version": {
      "const": 3
    },
    "kind": {
      "const": "sg_evals_github_repository_state"
    },
    "observed_at": {
      "type": "string"
    },
    "outcomes_consulted": {
      "const": false
    },
    "repository_count": {
      "type": "integer",
      "minimum": 1
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "audit_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_repository_id",
        "mirror_name",
        "exists",
        "is_fork",
        "parent",
        "visibility",
        "default_branch",
        "head_oid",
        "cutoff_oid"
      ],
      "properties": {
        "canonical_repository_id": {
          "type": "string",
          "minLength": 3
        },
        "mirror_name": {
          "type": "string",
          "pattern": "^github\\.com/sg-evals/"
        },
        "exists": {
          "type": "boolean"
        },
        "is_fork": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha1"
            },
            {
              "type": "null"
            }
          ]
        },
        "cutoff_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
