{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-authorship.local/study/repositories.schema.json",
  "title": "Pinned repository provenance manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "protocol_sha256",
    "cutoff",
    "selection",
    "repositories",
    "excluded_candidates"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"enum": [1, 2]},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cutoff": {"const": "2026-07-24T23:59:59Z"},
    "selection": {"type": "object"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "role",
          "label",
          "languages",
          "snapshot",
          "evidence",
          "effective_date_range",
          "excluded_paths",
          "retrieved_at",
          "content_checksum"
        ]
      }
    },
    "excluded_candidates": {"type": "array"}
  },
  "additionalProperties": false
}
