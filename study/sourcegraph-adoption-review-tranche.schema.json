{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-adoption-review-tranche.schema.json",
  "title": "Sequential Sourcegraph repository-adoption review tranche",
  "type": "object",
  "required": [
    "review_version",
    "tranche_id",
    "tranche_number",
    "case_index_sha256",
    "workflow_sha256",
    "prior_decision_ledger_sha256",
    "eligible_repository_count",
    "completed_repository_count",
    "exhausted_repository_count",
    "active_repository_count",
    "repository_count",
    "task_count",
    "tasks",
    "outcomes_consulted",
    "tranche_sha256"
  ],
  "properties": {
    "review_version": {
      "const": 3
    },
    "tranche_id": {
      "$ref": "#/$defs/sha256"
    },
    "tranche_number": {
      "type": "integer",
      "minimum": 1
    },
    "case_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "workflow_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prior_decision_ledger_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligible_repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "completed_repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "exhausted_repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "active_repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "task_count": {
      "type": "integer",
      "minimum": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "tranche_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "candidateEvent": {
      "type": "object",
      "required": [
        "commit_oid",
        "observed_at"
      ],
      "properties": {
        "commit_oid": {
          "$ref": "#/$defs/commit"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "rawEvidence": {
      "type": "object",
      "required": [
        "kind",
        "commit_oid",
        "path",
        "line",
        "value",
        "source_url"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "commit_oid": {
          "$ref": "#/$defs/commit"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "value": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "packetEvidence": {
      "type": "object",
      "required": [
        "packet_id",
        "packet_sha256",
        "query_family_id",
        "raw_evidence"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/sha256"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "query_family_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rawEvidence"
          }
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "review_version",
        "task_id",
        "case_index_sha256",
        "workflow_sha256",
        "case_id",
        "repository_case_sha256",
        "canonical_repository_id",
        "canonical_source_url",
        "sourcegraph_name",
        "cutoff_commit",
        "event_id",
        "candidate_event",
        "candidate_kind",
        "candidate_position",
        "candidate_count",
        "query_family_ids",
        "packet_ids",
        "evidence",
        "review_role",
        "review_question",
        "allowed_decisions",
        "outcomes_consulted",
        "task_sha256"
      ],
      "properties": {
        "review_version": {
          "const": 3
        },
        "task_id": {
          "$ref": "#/$defs/sha256"
        },
        "case_index_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "workflow_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_id": {
          "$ref": "#/$defs/sha256"
        },
        "repository_case_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_repository_id": {
          "type": "string",
          "minLength": 3
        },
        "canonical_source_url": {
          "type": "string",
          "format": "uri"
        },
        "sourcegraph_name": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_commit": {
          "$ref": "#/$defs/commit"
        },
        "event_id": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_event": {
          "$ref": "#/$defs/candidateEvent"
        },
        "candidate_kind": {
          "enum": [
            "adoption_challenge",
            "explicit_provenance_anchor"
          ]
        },
        "candidate_position": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1
        },
        "query_family_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "packet_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packetEvidence"
          }
        },
        "review_role": {
          "enum": [
            "primary",
            "secondary",
            "resolver"
          ]
        },
        "review_question": {
          "type": "string",
          "minLength": 1
        },
        "allowed_decisions": {
          "const": [
            "accept_confirmed",
            "accept_observed",
            "ambiguous",
            "insufficient",
            "reject"
          ]
        },
        "outcomes_consulted": {
          "const": false
        },
        "task_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  }
}
