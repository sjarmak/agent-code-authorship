{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sg-evals.example/study/survival-event-inventory.schema.json",
  "title": "Exact survival event inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "status",
    "git_inventory_sha256",
    "lineage_inventory_sha256",
    "lineage_validation_sha256",
    "counts",
    "repositories",
    "outcomes_consulted",
    "survival_event_inventory_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "git_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lineage_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lineage_validation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "valid",
        "invalid",
        "lines"
      ],
      "properties": {
        "repositories": {
          "type": "integer",
          "minimum": 1
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/valid_repository"
          },
          {
            "$ref": "#/$defs/invalid_repository"
          }
        ]
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "survival_event_inventory_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "valid_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "status",
        "line_count",
        "event_shard_file",
        "event_shard_sha256",
        "manifest_file",
        "manifest_sha256"
      ],
      "properties": {
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        },
        "status": {
          "const": "valid"
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        },
        "event_shard_file": {
          "type": "string",
          "pattern": "^[^/]+\\.jsonl$"
        },
        "event_shard_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_file": {
          "type": "string",
          "pattern": "^[^/]+\\.json$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "invalid_repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "status",
        "error"
      ],
      "properties": {
        "repository_id": {
          "$ref": "#/$defs/repository_id"
        },
        "status": {
          "const": "invalid"
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
