{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sg-evals.local/schemas/sg-evals-execution-journal.v3.json",
  "title": "Approval-scoped sg-evals execution journal v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_version",
    "plan_sha256",
    "approval_scope",
    "started_at",
    "updated_at",
    "status",
    "selected_count",
    "selected_repository_ids",
    "current_action",
    "results",
    "journal_sha256"
  ],
  "properties": {
    "execution_version": {
      "const": 3
    },
    "plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "approval_scope": {
      "enum": [
        "routine",
        "destructive"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "failed",
        "complete"
      ]
    },
    "selected_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_repository_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "current_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "journal_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_repository_id",
        "action",
        "status",
        "started_at",
        "completed_at",
        "commands",
        "error"
      ],
      "properties": {
        "canonical_repository_id": {
          "type": "string",
          "minLength": 3
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "completed_at": {
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "returncode",
        "stdout",
        "stderr"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "returncode": {
          "type": "integer"
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
