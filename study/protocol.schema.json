{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-authorship.local/study/protocol.schema.json",
  "title": "Agent code authorship replication protocol",
  "type": "object",
  "required": [
    "protocol_version",
    "status",
    "estimand",
    "snapshot",
    "provenance",
    "repository_roles",
    "sampling",
    "contamination_controls",
    "features",
    "models",
    "quantification",
    "evaluation",
    "identification_gates",
    "uncertainty",
    "storage",
    "reporting",
    "workflow"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"const": 1},
    "status": {"const": "preregistered"},
    "purpose": {"type": "string", "minLength": 1},
    "estimand": {"type": "object"},
    "snapshot": {"type": "object"},
    "provenance": {"type": "object"},
    "repository_roles": {"type": "object"},
    "sampling": {"type": "object"},
    "contamination_controls": {"type": "object"},
    "features": {"type": "object"},
    "models": {"type": "object"},
    "quantification": {"type": "object"},
    "evaluation": {"type": "object"},
    "identification_gates": {"type": "object"},
    "uncertainty": {"type": "object"},
    "storage": {"type": "object"},
    "reporting": {"type": "object"},
    "workflow": {"type": "object"}
  },
  "additionalProperties": false
}
