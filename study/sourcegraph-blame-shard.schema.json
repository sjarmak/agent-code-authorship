{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcegraph cutoff-pinned blame shard v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blame_shard_version",
    "group_id",
    "canonical_repository_id",
    "sourcegraph_name",
    "cutoff_commit",
    "path",
    "requested_lines",
    "blame_api_lines",
    "pending_enrichments",
    "executed_at",
    "raw_blame_response",
    "enrichments",
    "valid",
    "error",
    "outcomes_consulted",
    "blame_shard_sha256"
  ],
  "properties": {
    "blame_shard_version": {"const": 3},
    "group_id": {"$ref": "#/$defs/sha256"},
    "canonical_repository_id": {"type": "string", "minLength": 3},
    "sourcegraph_name": {"type": "string", "minLength": 1},
    "cutoff_commit": {"$ref": "#/$defs/sha1"},
    "path": {"type": "string", "minLength": 1},
    "requested_lines": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "blame_api_lines": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "pending_enrichments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pending"}
    },
    "executed_at": {"type": "string", "format": "date-time"},
    "raw_blame_response": {
      "oneOf": [{"type": "object"}, {"type": "null"}]
    },
    "enrichments": {
      "type": "array",
      "items": {"$ref": "#/$defs/enrichment"}
    },
    "valid": {"type": "boolean"},
    "error": {
      "oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]
    },
    "outcomes_consulted": {"const": false},
    "blame_shard_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resultId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_manifest_sha256",
        "sourcegraph_result_id",
        "canonical_repository_id",
        "sourcegraph_name",
        "cutoff_commit",
        "path",
        "sourcegraph_line_numbers"
      ],
      "properties": {
        "result_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sourcegraph_result_id": {"$ref": "#/$defs/resultId"},
        "canonical_repository_id": {"type": "string", "minLength": 3},
        "sourcegraph_name": {"type": "string", "minLength": 1},
        "cutoff_commit": {"$ref": "#/$defs/sha1"},
        "path": {"type": "string", "minLength": 1},
        "sourcegraph_line_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "commit_oid", "observed_at"],
      "properties": {
        "line": {"type": "integer", "minimum": 0},
        "commit_oid": {"$ref": "#/$defs/sha1"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "enrichment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_manifest_sha256",
        "sourcegraph_result_id",
        "indexed_revision_oid",
        "default_branch_reachable",
        "lines"
      ],
      "properties": {
        "result_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "sourcegraph_result_id": {"$ref": "#/$defs/resultId"},
        "indexed_revision_oid": {"$ref": "#/$defs/sha1"},
        "default_branch_reachable": {"const": true},
        "lines": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/line"}
        }
      }
    }
  }
}
