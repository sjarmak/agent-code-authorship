{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-repository-language-inventory.schema.json",
  "title": "Sourcegraph repository language inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "inventory_version",
    "case_index_sha256",
    "source_tranche_sha256",
    "observed_at",
    "sourcegraph_capability",
    "sourcegraph_scope",
    "scip_required",
    "index_manifest_sha256",
    "repository_name_map_sha256",
    "repository_count",
    "review_scope_exception_count",
    "language_counts",
    "repositories",
    "outcomes_consulted",
    "inventory_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "sourcegraph-repository-language-inventory.schema.json"
    },
    "inventory_version": {
      "const": 3
    },
    "case_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_tranche_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "sourcegraph_capability": {
      "const": "Repository.language"
    },
    "sourcegraph_scope": {
      "const": "github.com/sg-evals/*"
    },
    "scip_required": {
      "const": false
    },
    "index_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repository_name_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repository_count": {
      "type": "integer",
      "minimum": 1
    },
    "review_scope_exception_count": {
      "type": "integer",
      "minimum": 0
    },
    "language_counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_repository_id",
          "review_sourcegraph_name",
          "language_sourcegraph_name",
          "language"
        ],
        "properties": {
          "canonical_repository_id": {
            "type": "string",
            "minLength": 1
          },
          "review_sourcegraph_name": {
            "type": "string",
            "minLength": 1
          },
          "language_sourcegraph_name": {
            "type": "string",
            "pattern": "^github\\.com/sg-evals/"
          },
          "language": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
