{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-authorship.local/study/protocol-amendment.schema.json",
  "title": "Contemporary reference-label protocol amendment",
  "type": "object",
  "required": [
    "$schema",
    "amendment_version",
    "status",
    "preregistered_at",
    "purpose",
    "parent",
    "selection",
    "labels",
    "grouping",
    "roles",
    "identification",
    "historical_code",
    "unchanged"
  ],
  "properties": {
    "$schema": {"const": "protocol-amendment.schema.json"},
    "amendment_version": {"const": 2},
    "status": {"const": "preregistered"},
    "preregistered_at": {"type": "string", "format": "date-time"},
    "purpose": {"type": "string", "minLength": 1},
    "parent": {"type": "object"},
    "selection": {"type": "object"},
    "labels": {"type": "object"},
    "grouping": {"type": "object"},
    "roles": {"type": "object"},
    "identification": {"type": "object"},
    "historical_code": {"type": "object"},
    "unchanged": {"type": "object"}
  },
  "additionalProperties": false
}
