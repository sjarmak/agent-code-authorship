{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-ai-ban-review-response.schema.json",
  "title": "Fresh AI-ban semantic review response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response_version",
    "worksheet_sha256",
    "task_id",
    "task_sha256",
    "canonical_repository_id",
    "event_id",
    "review_role",
    "reviewer_id",
    "decision",
    "default_branch_supported",
    "policy_scope",
    "evidence_tier",
    "rationale",
    "evidence_citations",
    "outcomes_consulted",
    "response_sha256"
  ],
  "properties": {
    "response_version": {
      "const": 3
    },
    "worksheet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_id": {
      "$ref": "#/$defs/sha256"
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_repository_id": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "event_id": {
      "$ref": "#/$defs/sha256"
    },
    "review_role": {
      "enum": [
        "primary",
        "secondary",
        "resolver"
      ]
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "accept_policy",
        "ambiguous",
        "insufficient",
        "reject"
      ]
    },
    "default_branch_supported": {
      "type": "boolean"
    },
    "policy_scope": {
      "enum": [
        "repository_wide_ai_generated_contribution_prohibition",
        "not_applicable"
      ]
    },
    "evidence_tier": {
      "enum": [
        "datable_default_branch_policy",
        "not_applicable"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_citations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "response_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accept_policy"
          }
        }
      },
      "then": {
        "properties": {
          "default_branch_supported": {
            "const": true
          },
          "policy_scope": {
            "const": "repository_wide_ai_generated_contribution_prohibition"
          },
          "evidence_tier": {
            "const": "datable_default_branch_policy"
          }
        }
      },
      "else": {
        "properties": {
          "default_branch_supported": {
            "const": false
          },
          "policy_scope": {
            "const": "not_applicable"
          },
          "evidence_tier": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_role": {
            "const": "resolver"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "not": {
              "const": "ambiguous"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
