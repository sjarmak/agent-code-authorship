{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-adoption-audit-key.schema.json",
  "title": "Separated Sourcegraph adoption reliability-audit key",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "audit_version",
    "seed",
    "worksheet_sha256",
    "predecessors",
    "sample_count",
    "joint_stratum_count",
    "strata",
    "items",
    "outcomes_consulted",
    "key_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "sourcegraph-adoption-audit-key.schema.json"
    },
    "audit_version": {
      "const": 1
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "worksheet_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "predecessors": {
      "type": "object"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "joint_stratum_count": {
      "type": "integer",
      "minimum": 1
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "key_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": [
        "accept_confirmed",
        "accept_observed",
        "insufficient",
        "reject"
      ]
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "primary_decision",
        "evidence_channel",
        "language",
        "population_count",
        "target_sample_count",
        "actual_sample_count"
      ],
      "properties": {
        "stratum_id": {
          "$ref": "#/$defs/sha256"
        },
        "primary_decision": {
          "$ref": "#/$defs/decision"
        },
        "evidence_channel": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "population_count": {
          "type": "integer",
          "minimum": 1
        },
        "target_sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "actual_sample_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_task_id",
        "task_id",
        "task_sha256",
        "canonical_repository_id",
        "event_id",
        "primary_response_sha256",
        "primary_decision",
        "primary_reviewer_id",
        "primary_rationale",
        "primary_default_branch_supported",
        "primary_evidence_tier",
        "primary_evidence_citations",
        "stratum_id",
        "evidence_channel",
        "language"
      ],
      "properties": {
        "audit_task_id": {
          "$ref": "#/$defs/sha256"
        },
        "task_id": {
          "$ref": "#/$defs/sha256"
        },
        "task_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_repository_id": {
          "type": "string",
          "minLength": 3
        },
        "event_id": {
          "$ref": "#/$defs/sha256"
        },
        "primary_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "primary_decision": {
          "$ref": "#/$defs/decision"
        },
        "primary_reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_rationale": {
          "type": "string",
          "minLength": 1
        },
        "primary_default_branch_supported": {
          "type": "boolean"
        },
        "primary_evidence_tier": {
          "enum": [
            "confirmed",
            "observed",
            "not_applicable"
          ]
        },
        "primary_evidence_citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "stratum_id": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_channel": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
