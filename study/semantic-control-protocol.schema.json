{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol_version", "purpose", "input_artifacts", "input_sha256", "unit",
    "exposure", "treated_identity_construction", "outcome_blindness", "eligibility", "covariates",
    "task_classification", "matching", "observation", "estimands",
    "uncertainty", "identification_gates", "sensitivity", "protocol_sha256"
  ],
  "properties": {
    "protocol_version": {"const": 1},
    "purpose": {"type": "string", "minLength": 1},
    "input_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "unit": {"const": "introduced_diff_hunk"},
    "exposure": {"type": "object"},
    "treated_identity_construction": {"type": "object"},
    "outcome_blindness": {"type": "object"},
    "eligibility": {"type": "object"},
    "covariates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "task_classification": {"type": "object"},
    "matching": {"type": "object"},
    "observation": {"type": "object"},
    "estimands": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "uncertainty": {"type": "object"},
    "identification_gates": {"type": "object"},
    "sensitivity": {"type": "object"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
