{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-adjudication-batch-export.schema.json",
  "title": "Outcome-blind Sourcegraph adjudication batch export v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_export_version",
    "specification_sha256",
    "queue_manifest_sha256",
    "stage",
    "reviewer_id",
    "reviewer_kind",
    "reviewer_version",
    "provider",
    "model",
    "reasoning_effort",
    "prompt_sha256",
    "endpoint",
    "request_count",
    "max_requests_per_file",
    "max_bytes_per_file",
    "emitted_file_count",
    "files",
    "outcomes_consulted",
    "peer_reviews_consulted",
    "batch_manifest_sha256"
  ],
  "properties": {
    "batch_export_version": {
      "const": 3
    },
    "specification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "queue_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stage": {
      "const": "primary"
    },
    "reviewer_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_kind": {
      "const": "model"
    },
    "reviewer_version": {
      "const": "sourcegraph-adjudication-openai-batch-v3"
    },
    "provider": {
      "const": "openai"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "enum": [
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "endpoint": {
      "const": "/v1/responses"
    },
    "request_count": {
      "$ref": "#/$defs/positive_count"
    },
    "max_requests_per_file": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000
    },
    "max_bytes_per_file": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200000000
    },
    "emitted_file_count": {
      "$ref": "#/$defs/positive_count"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "peer_reviews_consulted": {
      "const": false
    },
    "batch_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "positive_count": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "request_count",
        "byte_count",
        "first_custom_id",
        "last_custom_id",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^requests/[0-9]{4}\\.jsonl$"
        },
        "request_count": {
          "$ref": "#/$defs/positive_count"
        },
        "byte_count": {
          "$ref": "#/$defs/positive_count"
        },
        "first_custom_id": {
          "$ref": "#/$defs/sha256"
        },
        "last_custom_id": {
          "$ref": "#/$defs/sha256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
