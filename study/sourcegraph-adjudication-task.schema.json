{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-adjudication-task.schema.json",
  "title": "Grouped Sourcegraph adjudication task v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_version",
    "task_id",
    "packet_type",
    "canonical_repository_id",
    "canonical_source_url",
    "sourcegraph_name",
    "cutoff_commit",
    "candidate_event",
    "packet_count",
    "observations",
    "outcomes_consulted",
    "task_sha256"
  ],
  "properties": {
    "task_version": {
      "const": 3
    },
    "task_id": {
      "$ref": "#/$defs/sha256"
    },
    "packet_type": {
      "enum": [
        "adoption_event",
        "ai_ban_policy"
      ]
    },
    "canonical_repository_id": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "canonical_source_url": {
      "type": "string",
      "pattern": "^https://github\\.com/"
    },
    "sourcegraph_name": {
      "type": "string",
      "pattern": "^github\\.com/sg-evals/"
    },
    "cutoff_commit": {
      "$ref": "#/$defs/sha1"
    },
    "candidate_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_oid",
        "observed_at"
      ],
      "properties": {
        "commit_oid": {
          "$ref": "#/$defs/sha1"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "packet_count": {
      "type": "integer",
      "minimum": 1
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "task_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "packet_sha256",
        "query_family_id",
        "rendered_query",
        "rendered_query_sha256",
        "sourcegraph_result_ids",
        "raw_evidence"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/sha256"
        },
        "packet_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "query_family_id": {
          "type": "string",
          "minLength": 1
        },
        "rendered_query": {
          "type": "string",
          "minLength": 1
        },
        "rendered_query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourcegraph_result_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "raw_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
