{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-authorship.local/study/reference-candidates.schema.json",
  "title": "Frozen outcome-blind contemporary reference candidate frame",
  "type": "object",
  "required": [
    "$schema",
    "frame_version",
    "status",
    "retrieved_at",
    "amendment_sha256",
    "target_manifest_sha256",
    "reference_manifest_sha256",
    "selection",
    "candidates"
  ],
  "properties": {
    "$schema": {"const": "reference-candidates.schema.json"},
    "frame_version": {"const": 2},
    "status": {"const": "frozen_before_solicitation"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "amendment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection": {"type": "object"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "language",
          "proposed_label",
          "source",
          "selection_key",
          "content_group",
          "metadata",
          "solicitation_status"
        ]
      }
    }
  },
  "additionalProperties": false
}
