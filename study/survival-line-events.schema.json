{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-code-authorship/survival-line-events.schema.json",
  "title": "Censoring-correct line event histories",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "lines"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256s": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transitions",
        "structural_events",
        "git_inventory"
      ],
      "properties": {
        "transitions": {
          "$ref": "#/$defs/sha256"
        },
        "structural_events": {
          "$ref": "#/$defs/sha256"
        },
        "git_inventory": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "line_count": {
      "type": "integer",
      "minimum": 1
    },
    "censoring_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_cutoff",
        "lineage_loss",
        "terminal_deletion"
      ],
      "properties": {
        "study_cutoff": {
          "type": "integer",
          "minimum": 0
        },
        "lineage_loss": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_deletion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "survival_event_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository_id",
          "line_id",
          "censor_time_days",
          "transitions"
        ],
        "properties": {
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "censor_time_days": {
            "type": "number",
            "minimum": 0
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "time_days",
                "from_state",
                "to_state"
              ],
              "properties": {
                "time_days": {
                  "type": "number",
                  "minimum": 0
                },
                "from_state": {
                  "enum": [
                    "unchanged",
                    "modified"
                  ]
                },
                "to_state": {
                  "enum": [
                    "modified",
                    "deleted"
                  ]
                }
              }
            }
          },
          "language": {
            "enum": [
              "Python",
              "Go"
            ]
          },
          "agent_family": {
            "type": "string",
            "minLength": 1
          },
          "evidence_tier": {
            "enum": [
              "tier_1",
              "tier_2"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
