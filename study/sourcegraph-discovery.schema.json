{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-discovery.schema.json",
  "title": "Frozen Sourcegraph discovery specification v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "specification_version",
    "status",
    "cutoff",
    "outcomes_consulted",
    "protocol_sha256",
    "index_manifest_sha256",
    "sourcegraph",
    "execution",
    "query_families",
    "evidence_packets",
    "adjudication",
    "freeze_outputs",
    "specification_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "sourcegraph-discovery.schema.json"
    },
    "specification_version": {
      "const": 3
    },
    "status": {
      "const": "frozen_before_discovery_execution"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "outcomes_consulted": {
      "const": false
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "index_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourcegraph": {
      "type": "object",
      "required": [
        "endpoint_role",
        "indexed_namespace",
        "repository_scope_source",
        "required_transport_status",
        "allowed_capabilities",
        "precise_code_intelligence_required",
        "scip_required",
        "forks_and_archives_explicit",
        "documentation",
        "structural_search"
      ],
      "properties": {
        "endpoint_role": {
          "type": "string"
        },
        "indexed_namespace": {
          "const": "github.com/sg-evals/"
        },
        "repository_scope_source": {
          "const": "study/sourcegraph-index-manifest.v3.json"
        },
        "required_transport_status": {
          "type": "array",
          "contains": {
            "const": "ready_mirror"
          }
        },
        "allowed_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "precise_code_intelligence_required": {
          "const": false
        },
        "scip_required": {
          "const": false
        },
        "forks_and_archives_explicit": {
          "const": true
        },
        "documentation": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "url",
              "use"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "use": {
                "type": "string"
              }
            }
          }
        },
        "structural_search": {
          "type": "object",
          "required": [
            "required",
            "saved_search_dependency",
            "role",
            "reason"
          ],
          "properties": {
            "required": {
              "const": false
            },
            "saved_search_dependency": {
              "const": false
            },
            "role": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "unit",
        "candidate_only",
        "semantic_label_from_query_match",
      "default_branch_history_only",
      "history_start",
      "before_exclusive",
      "repository_exclusions",
      "query_result_freeze",
      "cutoff_behavior"
      ],
      "properties": {
        "unit": {
          "type": "string"
        },
        "candidate_only": {
          "const": true
        },
        "semantic_label_from_query_match": {
          "const": false
        },
        "default_branch_history_only": {
          "const": true
        },
        "history_start": {
          "type": "string",
          "format": "date-time"
        },
      "before_exclusive": {
        "type": "string",
        "format": "date-time"
      },
      "repository_exclusions": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_artifact",
          "source_artifact_sha256",
          "repositories"
        ],
        "properties": {
          "source_artifact": {
            "type": "string",
            "minLength": 1
          },
          "source_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_repository_id",
                "disposition",
                "reason"
              ],
              "properties": {
                "canonical_repository_id": {
                  "type": "string",
                  "pattern": "^[^/]+/[^/]+$"
                },
                "disposition": {
                  "enum": [
                    "hold_private",
                    "hold_redistribution"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "query_result_freeze": {
          "type": "object"
        },
        "cutoff_behavior": {
          "type": "object"
        }
      }
    },
    "query_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/queryFamily"
      }
    },
    "evidence_packets": {
      "type": "object",
      "required": [
        "schema",
        "content_addressing",
        "raw_facts_only",
        "required_context_enrichment",
        "candidate_event_order",
        "deduplication_key"
      ],
      "properties": {
        "schema": {
          "const": "study/sourcegraph-evidence-packet.schema.json"
        },
        "content_addressing": {
          "type": "string"
        },
        "raw_facts_only": {
          "const": true
        },
        "required_context_enrichment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "candidate_event_order": {
          "type": "string"
        },
        "deduplication_key": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "adjudication": {
      "$ref": "#/$defs/adjudication"
    },
    "freeze_outputs": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "specification_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "queryFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "packet_types",
        "evidence_channels",
        "result_type",
        "saved_search_eligible",
        "required_capabilities",
        "query_template"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "purpose": {
          "type": "string"
        },
        "packet_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "adoption_event",
              "ai_ban_policy"
            ]
          }
        },
        "evidence_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "adoption_announcement",
              "agent_identity",
              "commit",
              "diff",
              "generated_code_disclosure",
              "policy",
              "revision_history",
              "trailer"
            ]
          }
        },
        "result_type": {
          "enum": [
            "commit",
            "diff",
            "file"
          ]
        },
        "saved_search_eligible": {
          "const": true
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "indexed_search",
              "revision_search",
              "commit_search",
              "diff_search",
              "blame",
              "repository_metadata"
            ]
          }
        },
        "query_template": {
          "type": "string",
          "pattern": "patternType:"
        }
      }
    },
    "adjudication": {
      "type": "object",
      "required": [
        "outcome_blind",
        "peer_review_blind",
        "independent_primary_reviews",
        "reviewer_record",
        "decision_sets",
        "rubrics",
        "disagreement_resolution",
        "agreement_audit"
      ],
      "properties": {
        "outcome_blind": {
          "const": true
        },
        "peer_review_blind": {
          "const": true
        },
        "independent_primary_reviews": {
          "const": 2
        },
        "reviewer_record": {
          "type": "object"
        },
        "decision_sets": {
          "type": "object",
          "required": [
            "adoption_event",
            "ai_ban_policy"
          ]
        },
        "rubrics": {
          "type": "object",
          "required": [
            "adoption_event",
            "ai_ban_policy"
          ]
        },
        "disagreement_resolution": {
          "type": "object",
          "required": [
            "reviewers",
            "reviewer_must_be_distinct",
            "blind_to_primary_decisions",
            "final_rule"
          ],
          "properties": {
            "reviewers": {
              "const": 1
            },
            "reviewer_must_be_distinct": {
              "const": true
            },
            "blind_to_primary_decisions": {
              "const": true
            },
            "final_rule": {
              "type": "string"
            }
          }
        },
        "agreement_audit": {
          "type": "object",
          "required": [
            "sample_basis_points",
            "deterministic",
            "seed",
            "strata",
            "selection",
            "reviewers",
            "reviewer_must_be_distinct",
            "blind_to_primary_decisions",
            "effect"
          ],
          "properties": {
            "sample_basis_points": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "deterministic": {
              "const": true
            },
            "seed": {
              "type": "string"
            },
            "strata": {
              "type": "array",
              "minItems": 2
            },
            "selection": {
              "type": "string"
            },
            "reviewers": {
              "const": 1
            },
            "reviewer_must_be_distinct": {
              "const": true
            },
            "blind_to_primary_decisions": {
              "const": true
            },
            "effect": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
