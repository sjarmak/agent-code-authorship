{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-discovery-partition-plan.schema.json",
  "title": "Sourcegraph discovery timeout partition plan v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partition_plan_version",
    "status",
    "specification_sha256",
    "strategy",
    "parent_count",
    "child_unit_count",
    "outcomes_consulted",
    "parents",
    "partition_plan_sha256"
  ],
  "properties": {
    "partition_plan_version": {
      "const": 3
    },
    "status": {
      "const": "frozen_before_partition_execution"
    },
    "specification_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "strategy": {
      "enum": [
        "fixed_14_day_windows_5m_timeout_with_one_day_boundary_overlap",
        "failed_14_day_windows_refined_to_1_day",
        "failed_daily_ai_ban_windows_refined_by_filename_policy_and_term"
      ]
    },
    "refinement_source_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "refinement_source_execution_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parent_count": {
      "type": "integer",
      "minimum": 1
    },
    "child_unit_count": {
      "type": "integer",
      "minimum": 1
    },
    "outcomes_consulted": {
      "const": false
    },
    "parents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parent"
      }
    },
    "partition_plan_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "failed_14_day_windows_refined_to_1_day"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "required": [
          "refinement_source_plan_sha256",
          "refinement_source_execution_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "strategy": {
            "const": "failed_daily_ai_ban_windows_refined_by_filename_policy_and_term"
          }
        },
        "required": [
          "strategy"
        ]
      },
      "then": {
        "required": [
          "refinement_source_plan_sha256",
          "refinement_source_execution_sha256"
        ]
      }
    }
  ],
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_family_id",
        "result_type",
        "canonical_repository_id",
        "sourcegraph_name",
        "cutoff_commit",
        "rendered_query",
        "rendered_query_sha256",
        "unit_id"
      ],
      "properties": {
        "query_family_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "result_type": {
          "enum": [
            "commit",
            "diff"
          ]
        },
        "canonical_repository_id": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "sourcegraph_name": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_commit": {
          "$ref": "#/$defs/sha1"
        },
        "rendered_query": {
          "type": "string",
          "minLength": 1
        },
        "rendered_query_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unit_id": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_exclusive",
        "before_exclusive",
        "unit"
      ],
      "properties": {
        "after_exclusive": {
          "$ref": "#/$defs/date"
        },
        "before_exclusive": {
          "$ref": "#/$defs/date"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_unit_id",
        "parent_result_manifest_sha256",
        "canonical_repository_id",
        "query_family_id",
        "coverage_start_exclusive",
        "coverage_end_exclusive",
        "boundary_overlap_days",
        "deduplication_key",
        "children"
      ],
      "properties": {
        "parent_unit_id": {
          "$ref": "#/$defs/sha256"
        },
        "parent_result_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_repository_id": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "query_family_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "coverage_start_exclusive": {
          "$ref": "#/$defs/date"
        },
        "coverage_end_exclusive": {
          "$ref": "#/$defs/date"
        },
        "boundary_overlap_days": {
          "const": 1
        },
        "deduplication_key": {
          "const": "sourcegraph_result_id"
        },
        "children": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/child"
          }
        }
      }
    }
  }
}
