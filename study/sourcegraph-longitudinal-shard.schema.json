{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-longitudinal-shard.schema.json",
  "title": "Sourcegraph-verified longitudinal hunk shard v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "longitudinal_shard_version",
    "execution_unit_id",
    "protocol_sha256",
    "canonical_repository_id",
    "sourcegraph_name",
    "cutoff_commit",
    "pinned_git",
    "sourcegraph",
    "horizons_days",
    "hunk_count",
    "excluded_hunk_count",
    "sourcegraph_git_disagreement_count",
    "hunks",
    "exclusions",
    "sourcegraph_git_disagreements",
    "outcomes_consulted",
    "longitudinal_shard_sha256"
  ],
  "properties": {
    "longitudinal_shard_version": {
      "const": 3
    },
    "execution_unit_id": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "canonical_repository_id": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "sourcegraph_name": {
      "type": "string",
      "pattern": "^github\\.com/sg-evals/"
    },
    "cutoff_commit": {
      "$ref": "#/$defs/sha1"
    },
    "pinned_git": {
      "$ref": "#/$defs/pinnedGit"
    },
    "sourcegraph": {
      "$ref": "#/$defs/sourcegraph"
    },
    "horizons_days": {
      "const": [
        30,
        90,
        180,
        365
      ]
    },
    "hunk_count": {
      "$ref": "#/$defs/count"
    },
    "excluded_hunk_count": {
      "$ref": "#/$defs/count"
    },
    "sourcegraph_git_disagreement_count": {
      "$ref": "#/$defs/count"
    },
    "hunks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hunk"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "sourcegraph_git_disagreements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disagreement"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "longitudinal_shard_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pinnedGit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoff_commit",
        "cutoff_tree",
        "bundle_sha256",
        "authoritative_for_lineage"
      ],
      "properties": {
        "cutoff_commit": {
          "$ref": "#/$defs/sha1"
        },
        "cutoff_tree": {
          "$ref": "#/$defs/sha1"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authoritative_for_lineage": {
          "const": true
        }
      }
    },
    "sourcegraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indexed_revision_oid",
        "capabilities_used",
        "precise_code_intelligence_used",
        "scip_used",
        "result_manifest_sha256s",
        "verification_status"
      ],
      "properties": {
        "indexed_revision_oid": {
          "$ref": "#/$defs/sha1"
        },
        "capabilities_used": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "indexed_search",
              "revision_search",
              "commit_search",
              "diff_search",
              "blame",
              "structural_search",
              "repository_metadata"
            ]
          }
        },
        "precise_code_intelligence_used": {
          "const": false
        },
        "scip_used": {
          "const": false
        },
        "result_manifest_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "verification_status": {
          "enum": [
            "verified",
            "disagreement",
            "incomplete",
            "no_included_hunks"
          ]
        }
      }
    },
    "stateCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unchanged",
        "modified_candidate",
        "deleted",
        "unobservable",
        "right_censored"
      ],
      "properties": {
        "unchanged": {
          "$ref": "#/$defs/count"
        },
        "modified_candidate": {
          "$ref": "#/$defs/count"
        },
        "deleted": {
          "$ref": "#/$defs/count"
        },
        "unobservable": {
          "$ref": "#/$defs/count"
        },
        "right_censored": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "30",
        "90",
        "180",
        "365"
      ],
      "properties": {
        "30": {
          "$ref": "#/$defs/stateCounts"
        },
        "90": {
          "$ref": "#/$defs/stateCounts"
        },
        "180": {
          "$ref": "#/$defs/stateCounts"
        },
        "365": {
          "$ref": "#/$defs/stateCounts"
        }
      }
    },
    "observabilityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable_lines",
        "unobservable_lines",
        "right_censored_lines"
      ],
      "properties": {
        "observable_lines": {
          "$ref": "#/$defs/count"
        },
        "unobservable_lines": {
          "$ref": "#/$defs/count"
        },
        "right_censored_lines": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "30",
        "90",
        "180",
        "365"
      ],
      "properties": {
        "30": {
          "$ref": "#/$defs/observabilityCounts"
        },
        "90": {
          "$ref": "#/$defs/observabilityCounts"
        },
        "180": {
          "$ref": "#/$defs/observabilityCounts"
        },
        "365": {
          "$ref": "#/$defs/observabilityCounts"
        }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hunk_id",
        "introducing_commit_oid",
        "diff_base_oid",
        "event_time",
        "path",
        "language",
        "change_size_lines",
        "code_age_days",
        "evidence_tier",
        "agent_family",
        "line_ids",
        "lineage",
        "lineage_sha256",
        "observability",
        "sourcegraph_verification",
        "sourcegraph_evidence"
      ],
      "properties": {
        "hunk_id": {
          "$ref": "#/$defs/sha256"
        },
        "introducing_commit_oid": {
          "$ref": "#/$defs/sha1"
        },
        "diff_base_oid": {
          "$ref": "#/$defs/sha1"
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "Python",
            "Go"
          ]
        },
        "change_size_lines": {
          "type": "integer",
          "minimum": 1
        },
        "code_age_days": {
          "type": "number",
          "minimum": 0
        },
        "evidence_tier": {
          "enum": [
            "tier_1",
            "tier_2"
          ]
        },
        "agent_family": {
          "type": "string",
          "minLength": 1
        },
        "line_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "lineage": {
          "$ref": "#/$defs/lineage"
        },
        "lineage_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observability": {
          "$ref": "#/$defs/observability"
        },
        "sourcegraph_verification": {
          "enum": [
            "verified",
            "disagreement",
            "missing"
          ]
        },
        "sourcegraph_evidence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourcegraphEvidence"
            }
          ]
        }
      }
    },
    "sourcegraphEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcegraph_result_ids",
        "blame_commit_oids"
      ],
      "properties": {
        "sourcegraph_result_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "blame_commit_oids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha1"
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hunk_id",
        "introducing_commit_oid",
        "path",
        "change_size_lines",
        "reason"
      ],
      "properties": {
        "hunk_id": {
          "$ref": "#/$defs/sha256"
        },
        "introducing_commit_oid": {
          "$ref": "#/$defs/sha1"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "change_size_lines": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "const": "vendored_or_generated_path"
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hunk_id",
        "fields"
      ],
      "properties": {
        "hunk_id": {
          "$ref": "#/$defs/sha256"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "introducing_commit_oid",
              "path",
              "sourcegraph_result_ids"
            ]
          }
        }
      }
    }
  }
}
