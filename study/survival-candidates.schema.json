{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-authorship.local/study/survival-candidates.schema.json",
  "title": "Frozen agent-code survival candidate frame",
  "type": "object",
  "required": [
    "frame_version",
    "status",
    "outcomes_consulted",
    "selection",
    "exclusions",
    "candidates",
    "protocol_sha256",
    "input_inventory_sha256",
    "github_reachability_sha256",
    "frame_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "frame_version": {"const": 1},
    "status": {"const": "github_default_branch_verified"},
    "outcomes_consulted": {"const": false},
    "selection": {"type": "object"},
    "exclusions": {"type": "object"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "github_reachability_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frame_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository_id",
          "repository_url",
          "language",
          "agent_family",
          "provenance_tier",
          "pull_requests",
          "commit_shas",
          "attributable_added_lines",
          "default_branch",
          "default_branch_status"
        ],
        "properties": {
          "repository_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "repository_url": {"type": "string"},
          "language": {"enum": ["Python", "Go"]},
          "agent_family": {"type": "string"},
          "provenance_tier": {"enum": [1, 2]},
          "pull_requests": {"type": "array", "minItems": 1},
          "commit_shas": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          },
          "attributable_added_lines": {"type": "integer", "minimum": 200},
          "default_branch": {"type": "string"},
          "default_branch_status": {"const": "github_verified"}
        }
      }
    }
  }
}
