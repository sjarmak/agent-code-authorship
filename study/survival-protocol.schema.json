{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-code-authorship.local/study/survival-protocol.schema.json",
  "title": "Agent-authored code survival study protocol",
  "type": "object",
  "required": [
    "protocol_version",
    "status",
    "purpose",
    "snapshot",
    "estimand",
    "provenance",
    "sourcegraph",
    "lineage",
    "sampling",
    "contextual_comparison",
    "analysis",
    "validation",
    "identification_gates",
    "storage",
    "reporting",
    "protocol_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "protocol_version": {"const": 1},
    "status": {"const": "preregistered"},
    "purpose": {"type": "string", "minLength": 1},
    "snapshot": {"type": "object"},
    "estimand": {"type": "object"},
    "provenance": {"type": "object"},
    "sourcegraph": {"type": "object"},
    "lineage": {"type": "object"},
    "sampling": {"type": "object"},
    "contextual_comparison": {"type": "object"},
    "analysis": {"type": "object"},
    "validation": {"type": "object"},
    "identification_gates": {"type": "object"},
    "storage": {"type": "object"},
    "reporting": {"type": "object"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
