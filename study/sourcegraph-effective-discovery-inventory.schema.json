{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcegraph effective discovery inventory v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effective_inventory_version",
    "status",
    "specification_sha256",
    "base_execution_manifest_sha256",
    "partition_plan_sha256",
    "partition_execution_sha256",
    "logical_unit_count",
    "base_result_manifest_count",
    "recovered_parent_count",
    "partition_child_result_manifest_count",
    "terminal_timeout_result_manifest_count",
    "terminal_execution_error_result_manifest_count",
    "effective_result_manifest_count",
    "outcomes_consulted",
    "units",
    "effective_inventory_sha256"
  ],
  "properties": {
    "effective_inventory_version": {"const": 3},
    "status": {
      "enum": [
        "complete",
        "complete_with_terminal_timeouts",
        "complete_with_terminal_execution_errors",
        "complete_with_terminal_failures"
      ]
    },
    "specification_sha256": {"$ref": "#/$defs/sha256"},
    "base_execution_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "partition_plan_sha256": {"$ref": "#/$defs/sha256"},
    "partition_execution_sha256": {"$ref": "#/$defs/sha256"},
    "logical_unit_count": {"type": "integer", "minimum": 1},
    "base_result_manifest_count": {"type": "integer", "minimum": 0},
    "recovered_parent_count": {"type": "integer", "minimum": 1},
    "partition_child_result_manifest_count": {"type": "integer", "minimum": 1},
    "terminal_timeout_result_manifest_count": {"type": "integer", "minimum": 0},
    "terminal_execution_error_result_manifest_count": {
      "type": "integer",
      "minimum": 0
    },
    "effective_result_manifest_count": {"type": "integer", "minimum": 1},
    "outcomes_consulted": {"const": false},
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/unit"}
    },
    "effective_inventory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "shard_path",
        "unit_id",
        "result_manifest_sha256",
        "result_count",
        "result_object_count"
      ],
      "properties": {
        "location": {"enum": ["base", "partition"]},
        "shard_path": {
          "type": "string",
          "pattern": "^(shards|partition-shards)/[a-z0-9_]+/[0-9a-f]{64}\\.json$"
        },
        "unit_id": {"$ref": "#/$defs/sha256"},
        "result_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "result_count": {"type": "integer", "minimum": 0},
        "result_object_count": {"type": "integer", "minimum": 0}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_unit_id",
        "canonical_repository_id",
        "query_family_id",
        "resolution",
        "source_result_manifest_sha256",
        "effective_result_manifests",
        "terminal_timeout_manifests",
        "terminal_execution_error_manifests"
      ],
      "properties": {
        "logical_unit_id": {"$ref": "#/$defs/sha256"},
        "canonical_repository_id": {
          "type": "string",
          "minLength": 3
        },
        "query_family_id": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "enum": [
            "base",
            "partition",
            "partition_with_terminal_timeouts",
            "partition_with_terminal_execution_errors",
            "partition_with_terminal_failures"
          ]
        },
        "source_result_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "effective_result_manifests": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        },
        "terminal_timeout_manifests": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        },
        "terminal_execution_error_manifests": {
          "type": "array",
          "items": {"$ref": "#/$defs/reference"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "partition_with_terminal_timeouts"
              }
            },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "terminal_timeout_manifests": {"minItems": 1},
              "terminal_execution_error_manifests": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "partition_with_terminal_execution_errors"
              }
            },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "terminal_timeout_manifests": {"maxItems": 0},
              "terminal_execution_error_manifests": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution": {
                "const": "partition_with_terminal_failures"
              }
            },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "terminal_timeout_manifests": {"minItems": 1},
              "terminal_execution_error_manifests": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution": {
                "enum": ["base", "partition"]
              }
            },
            "required": ["resolution"]
          },
          "then": {
            "properties": {
              "effective_result_manifests": {"minItems": 1},
              "terminal_timeout_manifests": {"maxItems": 0},
              "terminal_execution_error_manifests": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
