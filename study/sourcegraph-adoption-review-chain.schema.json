{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sourcegraph-adoption-review-chain.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "chain_version",
    "protocol_sha256",
    "case_index_sha256",
    "packet_index_sha256",
    "entries",
    "outcomes_consulted",
    "chain_sha256"
  ],
  "properties": {
    "$schema": {
      "const": "sourcegraph-adoption-review-chain.schema.json"
    },
    "chain_version": {
      "const": 3
    },
    "protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packet_index_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "outcomes_consulted": {
      "const": false
    },
    "chain_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "tranche_number",
        "tranche_sha256",
        "prior_decision_ledger_sha256",
        "decision_ledger_sha256"
      ],
      "properties": {
        "tranche_number": {
          "type": "integer",
          "minimum": 1
        },
        "tranche_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prior_decision_ledger_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "decision_ledger_sha256": {
          "$ref": "#/$defs/nullableSha256"
        }
      },
      "additionalProperties": false
    }
  }
}
